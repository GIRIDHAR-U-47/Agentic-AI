# R-Lens optional credentials and runtime switches
# Copy to `backend/.env` (or repo root `.env`) and fill in to unlock hosted LLM
# providers, vector RAG, and the demo discovery mode. Without credentials the
# system stays fully deterministic:
#   - `offline` provider (extractive, no network, no cost) for the agent + eval
#   - vector backend `off` (BM25-only, the basic_rag baseline is ALWAYS BM25)
#   - real arXiv search when reachable, or RLENS_FAKE_ARXIV=1 canned fixtures
# Every eval cell for an unkeyed provider stays PENDING -- the harness never
# pretends a provider ran when it did not.

# --- LLM credentials (single key for both chat + embeddings) -----------------

# OpenRouter (https://openrouter.ai/keys). ONE key unlocks:
#   - Two chat model slots for the eval harness: `openrouter` and `openrouter-strong`
#   - Embeddings via the same key (Nemotron 3 Embed 1B free by default)
# Offline output is never labelled OpenRouter -- keyed providers without a key
# are reported PENDING instead.
OPENROUTER_API_KEY=

# Optional model overrides (defaults shown)
# RLENS_OPENROUTER_MODEL=openai/gpt-4o-mini
# RLENS_OPENROUTER_MODEL_2=anthropic/claude-3.5-sonnet

# Optional: force a provider for the review agent / eval harness
# (offline|openrouter|openrouter-strong)
# RLENS_LLM_PROVIDER=

# --- Vector RAG (Chroma DB) --------------------------------------------------
# Retrieval backend for the agentic loop:
#   off    = BM25 only (default; identical to the original pilot behaviour)
#   chroma = local persistent Chroma DB + OpenRouter embeddings (single key)
# Vectors never leave the machine; retrieval is always restricted to the
# session's approved papers; vectors are deleted only on paper deletion.
# Fake and real embeddings use SEPARATE Chroma collections so they never mix.
RLENS_VECTOR_BACKEND=off
# RLENS_CHROMA_DIR=           # defaults to ./data/chroma/
# RLENS_CHROMA_COLLECTION_REAL=rlens_passages_real
# RLENS_CHROMA_COLLECTION_FAKE=rlens_passages_fake

# Embeddings via OpenRouter (same key as chat). One documented free model:
#   nvidia/nemotron-3-embed-1b:free  -- 4096 dims, 32K context, RAG-optimized
# Dimension is configurable; will be verified on first real call.
# OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# OPENROUTER_EMBEDDING_DIM=4096
# OPENROUTER_EMBEDDING_TIMEOUT_S=30

# --- arXiv discovery demo mode -----------------------------------------------
# RLENS_FAKE_ARXIV=1 swaps in a deterministic, in-process arXiv client with
# *real* paper fixtures (GCN, GAT, graph wavelet net, ...). It is clearly
# labelled "fake" in the UI discovery flow and is intended for offline demos
# and tests when the arXiv export API is unreachable / rate-limited.
# RLENS_FAKE_ARXIV=1

# --- Other runtime switches (mostly for tests) -------------------------------
# RLENS_DATA_DIR=
# RLENS_DB_PATH=
# RLENS_EVAL_RESULTS_DIR=
# RLENS_ARXIV_API_BASE=http://export.arxiv.org/api/query
# RLENS_DISCOVERY_MAX_RESULTS=8