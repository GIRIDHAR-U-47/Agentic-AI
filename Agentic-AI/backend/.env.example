# R-Lens optional credentials and runtime switches
# Copy to `backend/.env` (or repo root `.env`) and fill in to unlock hosted LLM
# providers, vector RAG, and the demo discovery mode.
#
# Without credentials the system uses the deterministic offline (extractive)
# provider. All eval cells for unkeyed providers stay PENDING -- the harness
# never pretends a provider ran when it did not.

# --- PRIMARY: Google Gemini (Recommended) ------------------------------------
# R-Lens defaults to Gemini as the primary LLM provider.
# Set RLENS_LLM_PROVIDER=gemini and provide your API key to activate.
# Get your key at: https://aistudio.google.com/app/apikey
#
RLENS_LLM_PROVIDER=gemini
# GEMINI_API_KEY=<your-gemini-api-key-here>
# GOOGLE_API_KEY=<alternative-key-variable>    # also accepted

# Gemini model override (default: gemini-2.0-flash, also works with gemini-1.5-pro etc.)
# RLENS_GEMINI_MODEL=gemini-2.0-flash

# --- Token Budget Controls (Gemini free-tier optimized defaults) -------------
# Reduce to stay within free-tier quotas; increase for more detailed responses.
# GEMINI_MAX_OUTPUT_TOKENS=1024
# NORMAL_CHAT_MAX_OUTPUT_TOKENS=1024
# RAG_ANSWER_MAX_OUTPUT_TOKENS=1024
# LITERATURE_SYNTHESIS_MAX_OUTPUT_TOKENS=1536
# RECENT_MESSAGE_LIMIT=6

# --- Agent Iteration Limits --------------------------------------------------
# Reduce these to save tokens; increase for deeper multi-hop reasoning.
# RLENS_MAX_AGENT_ITERATIONS=3
# RLENS_MAX_TOOL_CALLS=6
# RLENS_MAX_QUERY_REFINEMENTS=1
# RLENS_RETRIEVAL_TOP_K=5

# --- ALTERNATIVE: OpenRouter -------------------------------------------------
# Uncomment and set RLENS_LLM_PROVIDER=openrouter to use OpenRouter instead.
# RLENS_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# RLENS_OPENROUTER_MODEL=openai/gpt-4o-mini
# RLENS_OPENROUTER_MODEL_2=anthropic/claude-3.5-sonnet

# --- Vector RAG (Chroma DB) --------------------------------------------------
# Retrieval backend for the agentic loop:
#   off    = BM25 only (default; identical to the original pilot behaviour)
#   chroma = local persistent Chroma DB (uses OpenRouter embeddings if key is present,
#            otherwise falls back to local deterministic fake embeddings)
RLENS_VECTOR_BACKEND=off
# RLENS_CHROMA_DIR=           # defaults to ./data/chroma/
# RLENS_CHROMA_COLLECTION_REAL=rlens_passages_real
# RLENS_CHROMA_COLLECTION_FAKE=rlens_passages_fake

# Embeddings via OpenRouter (same key as chat model).
# OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# OPENROUTER_EMBEDDING_DIM=4096
# OPENROUTER_EMBEDDING_TIMEOUT_S=30

# --- arXiv discovery demo mode -----------------------------------------------
# RLENS_FAKE_ARXIV=1 swaps in a deterministic, in-process arXiv client with
# real paper fixtures (GCN, GAT, graph wavelet net, ...). Useful for offline demos.
# RLENS_FAKE_ARXIV=1

# --- Other runtime switches --------------------------------------------------
# RLENS_DATA_DIR=
# RLENS_DB_PATH=
# RLENS_EVAL_RESULTS_DIR=
# RLENS_ARXIV_API_BASE=http://export.arxiv.org/api/query
# RLENS_DISCOVERY_MAX_RESULTS=6